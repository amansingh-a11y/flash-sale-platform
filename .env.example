# Copy to .env and replace the placeholders. Never commit .env.
# Generate values with: openssl rand -hex 32

# HMAC key shared with the waiting room; signs admission tokens.
ADMISSION_SECRET=replace-with-openssl-rand-hex-32
# Protects /admin/* (seeding a drop, stats).
ADMIN_TOKEN=replace-with-openssl-rand-hex-32

HTTP_ADDR=:8080
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

HOLD_TTL=10m
PAYMENT_DEADLINE=2m
RECONCILE_INTERVAL=1s

# Bulkhead sizes per request class (per instance).
MAX_INFLIGHT_READ=2000
MAX_INFLIGHT_RESERVE=500
MAX_INFLIGHT_PAY=200

# PSP client
PSP_ATTEMPT_TIMEOUT=3s
PSP_MAX_CONCURRENCY=100

# Fake PSP behaviour (prototype only)
PSP_FAKE_LATENCY=80ms
PSP_FAKE_TRANSIENT_RATE=0.02
PSP_FAKE_AMBIGUOUS_RATE=0.01
PSP_FAKE_DECLINE_RATE=0.02
